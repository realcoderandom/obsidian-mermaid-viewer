{
  "name": "mermaid-viewer",
  "version": "1.5.2",
  "private": true,
  "description": "Light-surface Mermaid viewer for Obsidian.",
  "repository": {
    "type": "git",
    "url": "https://github.com/realcoderandom/obsidian-mermaid-viewer.git"
  },
  "homepage": "https://github.com/realcoderandom/obsidian-mermaid-viewer#readme",
  "bugs": {
    "url": "https://github.com/realcoderandom/obsidian-mermaid-viewer/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "npm run typecheck && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests/unit && npm run lint:css",
    "format": "prettier --write src scripts tests docs *.json *.md *.mjs styles.css .github",
    "format:check": "prettier --check src scripts tests docs *.json *.md *.mjs styles.css .github",
    "test:unit": "node scripts/build-tests.mjs && node --test tests/unit/*.test.cjs",
    "test:browser": "node scripts/build-tests.mjs && node tests/viewer.cjs sequence && node tests/viewer.cjs flow && node tests/theme.cjs && node tests/integration.cjs",
    "test": "npm run test:unit && npm run test:browser",
    "check": "npm run lint && npm run format:check && npm run build && npm test && npm run check:package",
    "check:package": "node scripts/check-package.mjs",
    "release:check": "node scripts/check-package.mjs --release",
    "version:set": "node scripts/version.mjs",
    "install:local": "node scripts/install-local.mjs",
    "docs:images": "node scripts/render-examples.mjs",
    "lint:css": "stylelint styles.css \"src/**/*.css\""
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "mermaid": "12.1.0",
    "obsidian": "1.13.1",
    "prettier": "3.9.9",
    "puppeteer": "25.12.0",
    "stylelint": "17.16.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  },
  "author": "realcoderandom"
}
